<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Pilates Garden – Mat Pilates Outdoors</title>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inria+Serif:wght@700&family=Intel+One+Mono:wght@300&family=Inria+Sans:wght@400&display=swap" rel="stylesheet">

  <style>
    :root {
      --cream: #F3EDE5;
      --green: #212C16;
      --accent: #563D1A;

      --heading-serif: 'Inria Serif', serif;
      --heading-mono: 'Intel One Mono', monospace;
      --body-font: 'Inria Sans', sans-serif;

      --button-radius: 170px;
      --button-padding: 5px 50px;

      --section-padding-y: 25px;
      --card-padding: 50px;
      --card-gap: 15px;

      --nav-height: 8px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: var(--cream);
      color: var(--green);
      font-family: var(--body-font);
      font-size: 16px;
      line-height: 1.5;
    }

    main {
      max-width: 10px;
      margin: 0 auto;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    img {
      max-width: 100%;
      height: auto;
      display: block;
    }

    button,
    .button {
      border-radius: var(--button-radius);
      padding: var(--button-padding);
      border: none;
      cursor: pointer;
      font-size: 30px;
      font-family: var(--body-font);
    }

    /* HEADER / NAVIGATION */

    header {
      background: var(--cream);
    }

    .site-header {
      height: var(--nav-height);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 20px;
    }

    .logo {
      font-family: var(--heading-serif);
      font-size: 20px;
    }

    .main-nav {
      display: flex;
      align-items: center;
      gap: 40px;
    }

    .main-nav a {
      font-size: 20px;
      letter-spacing: 0;
      color: var(--green);
    }

    .nav-button {
      background: var(--green);
      color: var(--cream);
    }

    .hamburger {
      display: none;
      background: none;
      border: 2px solid var(--green);
      border-radius: 6px;
      padding: 6px 10px;
      font-size: 18px;
    }

    .mobile-menu {
      display: none;
      flex-direction: column;
      gap: 10px;
      padding: 10px 20px;
      background: var(--cream);
    }

    .mobile-menu a {
      font-size: 18px;
      color: var(--green);
    }

    /* HERO SECTION */

    .hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      padding: var(--section-padding-y) 20px;
      background: var(--cream);
    }

    .hero-content {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .hero-subheading {
      font-family: var(--heading-mono);
      font-size: 28px;
      font-weight: 300;
      text-transform: uppercase;
    }

    .hero-title {
      font-family: var(--heading-serif);
      font-size: 40px;
      font-weight: 700;
    }

    .hero-tagline {
      font-family: var(--heading-mono);
      font-size: 28px;
      font-weight: 300;
    }

    .hero-button {
      background: var(--green);
      color: var(--cream);
      display: inline-block;
      margin-top: 10px;
    }

    .hero-image {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* CLASSES SECTION */

    .classes-section {
      background: var(--green);
      color: var(--cream);
      padding: var(--section-padding-y) 20px;
    }

    .classes-heading {
      text-align: center;
      margin-bottom: 30px;
      font-family: var(--heading-serif);
      font-size: 28px;
    }

    .class-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--card-gap);
    }

    .class-card {
      background: var(--green);
      padding: var(--card-padding);
      border: 1px solid var(--cream);
    }

    .class-card h3 {
      font-family: var(--heading-serif);
      font-size: 28px;
      margin-top: 10px;
      margin-bottom: 10px;
    }

    .class-card p {
      font-size: 16px;
      line-height: 1.5;
    }

    /* ABOUT SECTION */

    .about-section {
      background: var(--cream);
      color: var(--green);
      padding: var(--section-padding-y) 20px;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      align-items: center;
    }

    .about-text {
      order: 1;
    }

    .about-image {
      order: 2;
    }

    .about-title-tag {
      font-family: var(--heading-mono);
      font-size: 28px;
      font-weight: 300;
    }

    .about-title-main {
      font-family: var(--heading-serif);
      font-size: 40px;
      font-weight: 700;
      margin-top: 10px;
      margin-bottom: 10px;
    }

    .about-text p {
      font-size: 16px;
      line-height: 1.5;
      margin-bottom: 10px;
    }

    .about-button {
      background: var(--green);
      color: var(--cream);
    }

    /* LOCATION SECTION */

    .location-section {
      background: var(--green);
      color: var(--cream);
      padding: var(--section-padding-y) 20px;
    }

    .location-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      align-items: center;
    }

    .location-text h1 {
      font-family: var(--heading-serif);
      font-size: 40px;
      margin-bottom: 15px;
    }

    .location-text h2 {
      font-family: var(--heading-mono);
      font-size: 28px;
      font-weight: 300;
      margin-bottom: 15px;
    }

    .location-text p {
      font-size: 16px;
      margin-bottom: 15px;
    }

    .location-buttons {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .location-buttons .button {
      background: var(--cream);
      color: var(--green);
    }

    .location-map img {
      width: 100%;
      height: auto;
      border-radius: 8px;
    }

    /* CONTACT SECTION */

    .contact-section {
      background: var(--cream);
      color: var(--green);
      padding: var(--section-padding-y) 20px;
      text-align: center;
    }

    .contact-heading {
      font-family: var(--heading-serif);
      font-size: 28px;
      margin-bottom: 20px;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 20px;
    }

    .contact-item h3 {
      font-family: var(--heading-serif);
      font-size: 18px;
      margin-bottom: 5px;
    }

    .contact-item p {
      font-size: 16px;
      margin: 0;
    }

    .contact-logo {
      font-family: var(--heading-serif);
      font-size: 24px;
      margin-top: 10px;
    }

    /* FOOTER */

    footer {
      background: var(--green);
      color: var(--cream);
      padding: 20px;
    }

    .footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 20px;
    }

    .footer-logo {
      font-family: var(--heading-serif);
      font-size: 20px;
    }

    .footer-links {
      display: flex;
      flex-wrap: wrap;
      gap: 15px;
      font-size: 16px;
    }

    .footer-links a {
      color: var(--cream);
    }

    /* EXTRA LAYOUT BREAKPOINTS */

    @media (max-width: 1035px) {
      .class-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 950px) {
      .about-grid {
        grid-template-columns: 1fr;
      }

      .about-image {
        order: 1;
      }

      .about-text {
        order: 2;
        text-align: center;
      }

      .about-text p {
        max-width: 630px;
        margin: 0 auto 10px;
      }
    }

    /* TABLET NAV + GENERAL RESPONSIVE */

    @media (max-width: 768px) {
      .site-header {
        flex-direction: row;
        justify-content: space-between;
      }

      .main-nav {
        display: none;
      }

      .hamburger {
        display: inline-block;
      }

      .mobile-menu {
        display: none;
      }

      .mobile-menu.open {
        display: flex;
      }

      .hero {
        grid-template-columns: 1fr;
      }

      .location-grid {
        grid-template-columns: 1fr;
      }

      .contact-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .footer-inner {
        flex-direction: column;
        text-align: center;
      }
    }

    /* MOBILE */

    @media (max-width: 480px) {
      .class-grid {
        grid-template-columns: 1fr;
      }

      .contact-grid {
        grid-template-columns: 1fr;
      }

      .hero-title {
        font-size: 28px;
      }

      .location-text h1 {
        font-size: 28px;
      }

      .about-title-main {
        font-size: 28px;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="site-header">
      <a href="#home" class="logo">The Pilates Garden</a>

      <nav class="main-nav" aria-label="Main navigation">
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#pricing">Memberships/Pricing</a>
        <a href="#contact">Contact</a>
        <button class="nav-button" type="button">Book now</button>
      </nav>

      <button class="hamburger" type="button" aria-label="Toggle navigation menu" aria-expanded="false">
        ☰
      </button>
    </div>

    <nav class="mobile-menu" aria-label="Mobile navigation">
      <a href="#home">Home</a>
      <a href="#about">About</a>
      <a href="#pricing">Memberships/Pricing</a>
      <a href="#contact">Contact</a>
      <button class="nav-button" type="button">Book now</button>
    </nav>
  </header>

  <main>

    <!-- HERO SECTION -->
    <section class="hero" id="home" aria-labelledby="hero-title">
      <div class="hero-content">
        <p class="hero-subheading">MIND.BODY.CONNECTION</p>
        <h1 class="hero-title" id="hero-title">Mat Pilates</h1>
        <p class="hero-tagline">The Pilates Garden</p>
        <button class="hero-button" type="button">Book A Class</button>
      </div>
      <div class="hero-image">
        <img src="images/hero-pilates.jpg" alt="Person practising mat Pilates outdoors in a garden setting">
      </div>
    </section>

    <!-- CLASSES SECTION -->
    <section class="classes-section" id="classes" aria-labelledby="classes-heading">
      <h2 class="classes-heading" id="classes-heading">—————— Classes —————</h2>

      <div class="class-grid">
        <article class="class-card">
          <img src="images/sculpt.jpg" alt="Instructor guiding a Sculpt Pilates class outdoors">
          <h3>Sculpt</h3>
          <p>Strength-focused mat Pilates to tone and define your body.</p>
        </article>

        <article class="class-card">
          <img src="images/sweat.jpg" alt="Group performing dynamic Pilates movements in a Sweat class">
          <h3>Sweat</h3>
          <p>Dynamic, energising flows to elevate your heart rate.</p>
        </article>

        <article class="class-card">
          <img src="images/stretch.jpg" alt="Person stretching on a mat in a calm outdoor space">
          <h3>Stretch</h3>
          <p>Lengthening sequences to improve mobility and release tension.</p>
        </article>

        <article class="class-card">
          <img src="images/sunset.jpg" alt="Pilates class at sunset with warm light and relaxed atmosphere">
          <h3>Sunset</h3>
          <p>Evening outdoor sessions to unwind as the sun goes down.</p>
        </article>
      </div>
    </section>

    <!-- ABOUT OUR PILATES STYLE -->
    <section class="about-section" id="about" aria-labelledby="about-title-main">
      <div class="about-grid">
        <div class="about-text">
          <h2 class="about-title-tag">The Pilates Garden</h2>
          <h1 class="about-title-main" id="about-title-main">About Our Pilates Style</h1>
          <p>
            At The Pilates Garden, our mat Pilates blends mindful movement, breathwork,
            and outdoor energy to create a grounded, uplifting practice.
          </p>
          <button class="about-button" type="button">Learn More</button>
        </div>
        <div class="about-image">
          <img src="images/about-pilates.jpg" alt="Outdoor Pilates session with mats arranged in a garden">
        </div>
      </div>
    </section>

    <!-- LOCATION SECTION -->
    <section class="location-section" id="location" aria-labelledby="location-title">
      <div class="location-grid">
        <div class="location-text">
          <h1 id="location-title">Location</h1>
          <h2>Gold Coast Australia</h2>
          <p>
            Join us in our tranquil outdoor space on the Gold Coast, surrounded by greenery and fresh air.
          </p>
          <div class="location-buttons">
            <button class="button" type="button">Book Now</button>
            <button class="button" type="button">Learn More</button>
          </div>
        </div>
        <div class="location-map">
          <img src="images/map-goldcoast.jpg" alt="Map showing The Pilates Garden location on the Gold Coast">
        </div>
      </div>
    </section>

    <!-- CONTACT SECTION -->
    <section class="contact-section" id="contact" aria-labelledby="contact-heading">
      <h2 class="contact-heading" id="contact-heading">—————— Contact —————</h2>

      <div class="contact-grid">
        <article class="contact-item">
          <h3>Email</h3>
          <p>hello@thepilatesgarden.com</p>
        </article>
        <article class="contact-item">
          <h3>Number</h3>
          <p>+61 4XX XXX XXX</p>
        </article>
        <article class="contact-item">
          <h3>Location</h3>
          <p>Gold Coast, QLD, Australia</p>
        </article>
        <article class="contact-item">
          <h3>Instagram</h3>
          <p>@thepilatesgarden</p>
        </article>
      </div>

      <div class="contact-logo">The Pilates Garden</div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer aria-label="Footer">
    <div class="footer-inner">
      <div class="footer-logo">The Pilates Garden</div>
      <div class="footer-links">
        <a href="#contact">Contact</a>
        <a href="#pricing">Memberships/Pricing</a>
        <a href="#classes">Class Types</a>
        <a href="#about">About</a>
        <a href="#location">Learn More</a>
      </div>
    </div>
  </footer>

  <script>
    const hamburger = document.querySelector('.hamburger');
    const mobileMenu = document.querySelector('.mobile-menu');

    hamburger.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.toggle('open');
      hamburger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });

    hamburger.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        const isOpen = mobileMenu.classList.toggle('open');
        hamburger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      }
    });
  </script>
</body>
</html>
